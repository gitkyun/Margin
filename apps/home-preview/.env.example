# Browser-safe Supabase publishable key. Never put server secrets in VITE_*.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Optional: Cloudflare file Worker address (R2). Defaults to the production Worker.
VITE_FILE_WORKER_URL=
# 1이면 로그인·가입 화면에 라인 로그인 버튼을 보여 줘요. Supabase에 custom:line 제공자를 등록한 뒤 켜요.
VITE_LINE_LOGIN=
