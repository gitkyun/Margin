# Copy to ignored .env.functions.local, never paste real values in chat or commit them.
GEMINI_API_KEY=replace_in_local_file
GEMINI_MODEL=gemini-3.8-flash
ALLOWED_ORIGINS=http://localhost:4175,http://127.0.0.1:4175,https://replace-with-project.pages.dev
# 비워 두면 키 모양으로 정합니다: AIza… 는 studio(Gemini API), 그 밖은 vertex(Vertex AI)
# GEMINI_PROVIDER=vertex
# Google Cloud 일반 프로젝트: 서비스 계정에 연결한 기존 키와 함께 global 경로를 사용합니다.
# GEMINI_PROJECT_ID=your-google-cloud-project-id
